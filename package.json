{
  "name": "git-agents",
  "version": "1.0.1",
  "description": "Agent skill to sync portable AI coding harness files and global instructions across machines and harnesses using git",
  "type": "module",
  "license": "MIT",
  "author": "Florent Klein",
  "keywords": [
    "git",
    "cli",
    "skill",
    "claude",
    "codex",
    "cursor",
    "gemini",
    "opencode",
    "agents",
    "skills",
    "sync"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/floklein/git-agents.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ga": "dist/index.js",
    "git-agents": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
