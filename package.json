{
  "name": "git-agents",
  "version": "0.3.0",
  "description": "TUI CLI to sync your AI agents and skills across machines using git",
  "type": "module",
  "license": "MIT",
  "author": "Florent Klein",
  "keywords": [
    "git",
    "tui",
    "cli",
    "claude",
    "agents",
    "skills",
    "sync",
    "worktree"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/floklein/git-agents.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ga": "dist/index.js",
    "git-agents": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx watch src/index.tsx",
    "start": "tsx src/index.tsx",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "ink-big-text": "^2.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/ink-big-text": "^1.2.4",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "esbuild": "^0.28.1",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
